{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/gallery/layout,_N_T_/gallery/[slug]/layout,_N_T_/gallery/[slug]/page,_N_T_/gallery/highlights-of-kerala/"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/gallery/$d$slug/__PAGE__",
    "/gallery/$d$slug",
    "/gallery",
    "/_index",
    "/_head"
  ]
}