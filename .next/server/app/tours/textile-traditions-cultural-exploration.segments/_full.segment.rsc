5:["$","main",null,{"className":"w-full bg-background","children":[["$","$Le",null,{}],["$","section",null,{"className":"relative overflow-hidden flex items-center min-h-[260px] md:min-h-[360px]","children":[["$","div",null,{"className":"absolute inset-0 bg-cover bg-center","style":{"backgroundImage":"url('/images/rithu-dmc-about-2004.jpg')"}}],["$","div",null,{"className":"absolute inset-0 bg-black/45"}],["$","div",null,{"className":"relative w-full py-16 md:py-20 lg:py-24","children":["$","div",null,{"className":"max-w-4xl mx-auto px-4 flex flex-col items-center justify-center text-center space-y-3","children":[["$","p",null,{"className":"text-[11px] md:text-xs tracking-[0.3em] uppercase text-white/70","children":"Tour"}],["$","h1",null,{"className":"text-3xl md:text-4xl lg:text-5xl font-light text-white tracking-tight","children":"Textile traditions & a cultural exploration"}],["$","p",null,{"className":"text-xs md:text-sm text-white/80 uppercase tracking-wide","children":"Tamil Nadu, Karnataka & Kerala"}]]}]}]]}],["$","section",null,{"className":"py-10 md:py-14 px-4 bg-gradient-to-b from-muted/30 via-background to-muted/40","children":["$","div",null,{"className":"max-w-6xl mx-auto text-sm md:text-base text-muted-foreground","children":["$","$Lf",null,{"defaultValue":"overview","className":"gap-6","children":[["$","$L10",null,{"className":"mb-6 flex flex-wrap","children":[["$","$L11",null,{"value":"overview","children":"Overview"}],["$","$L11",null,{"value":"itinerary","children":"Itinerary"}],["$","$L11",null,{"value":"highlights","children":"Highlights"}],["$","$L11",null,{"value":"gallery","children":"Gallery"}],["$","$L11",null,{"value":"map","children":"Map"}],["$","$L11",null,{"value":"more","children":"More"}]]}],["$","$L12",null,{"value":"overview","className":"leading-relaxed","children":["$","div",null,{"className":"bg-card rounded-2xl shadow-sm border border-border/60 p-6 md:p-8 space-y-4 text-justify","children":[["$","h2",null,{"className":"text-base md:text-lg font-semibold text-foreground mb-2","children":"Overview"}],[["$","p","South India, with its rich history, dive",{"children":"South India, with its rich history, diverse traditions and vibrant artisan communities, offers a unique and immersive journey for travellers interested in textiles and cultural heritage. This tour is not just a showcase of exquisite fabrics and intricate weaving techniques, but also a deep dive into living traditions, temple architecture, cuisine and the daily life of communities in Tamil Nadu, Karnataka and Kerala."}],["$","p","It is a popular journey for guests who w",{"children":"It is a popular journey for guests who would like a complete experience across three states. You not only see the textile methods practised in each region but also experience how diverse they are in their way of life, culture and cuisine. Do get in touch for more details or to have a customised trip arranged to suit your specific interests."}]]]}]}],["$","$L12",null,{"value":"itinerary","className":"leading-relaxed","children":["$","div",null,{"className":"bg-card rounded-2xl shadow-sm border border-border/60 p-6 md:p-8 space-y-4","children":[["$","h2",null,{"className":"text-base md:text-lg font-semibold text-foreground text-center mb-4","children":"Itinerary"}],["$","div",null,{"className":"space-y-2 text-justify","children":[["$","p","Day 1 – Bangalore: Arrive Bangalore and ",{"children":"Day 1 – Bangalore: Arrive Bangalore and transfer to your hotel. Depending on arrival time, visit Tharangini, a textile unit producing printed fabric using natural dyes."}],["$","p","Day 2 – Bangalore – Mysore: Drive to Mys",{"children":"Day 2 – Bangalore – Mysore: Drive to Mysore visiting a Channapatna toy-making unit and the government silk cocoon market en route. Evening walk through Devaraja fruit and vegetable market."}],["$","p","Day 3 – Mysore: Visit a village on the o",{"children":"Day 3 – Mysore: Visit a village on the outskirts of Mysore to experience the full process of the silk industry, followed by Somnathpur temple and the city palace with a stop at the silk factory."}],"$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21"]}]]}]}],"$L22","$L23","$L24","$L25"]}]}]}],"$L26"]}]
