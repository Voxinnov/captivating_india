6:["$","div",null,{"className":"max-w-7xl mx-auto","children":["$","$Lb",null,{"activities":[{"id":1,"title":"Backwater Village Experience","slug":"backwater-village-experience","place_id":12,"location":"Kumarakom","description":"Glide through narrow canals on a country boat, stopping at small villages to see coir making, toddy tapping and traditional fishing, with a simple home‑cooked lunch.","image":"https://captivationgindia.bvox.in/storage/activities/HCZTXJOFHSk5L1jCZvqfQXeeiuEPhsIeHGlZ3Iuf.jpg"},{"id":5,"title":"Soft Adventure & Day Hikes","slug":"soft-adventure-day-hikes","place_id":10,"location":"Wayanad","description":"Gentle treks, village‑to‑village walks and viewpoints that suit most fitness levels, accompanied by experienced local guides with a focus on safety and scenery.","image":"/images/rithu-dmc-about-3709.jpg"},{"id":6,"title":"Wildlife Safaris & Boat Cruises","slug":"wildlife-safaris-boat-cruises","place_id":11,"location":"Periyar National Park","description":"Early‑morning or late‑afternoon safaris in selected reserves, combining jeep drives and, where possible, boat cruises with a strong emphasis on responsible tourism.","image":"https://captivationgindia.bvox.in/storage/activities/wAUcu11w2K02XGcYG40oBkTYrCmcofqaKCJdph49.jpg"}],"places":[{"id":3,"title":"Cochin","slug":"cochin"},{"id":9,"title":"Kovalam","slug":"kovalam"},{"id":10,"title":"Wayanad","slug":"wayanad"},{"id":11,"title":"Periyar National Park","slug":"periyar-national-park"},{"id":12,"title":"Kumarakom","slug":"kumarakom"}]}]}]
