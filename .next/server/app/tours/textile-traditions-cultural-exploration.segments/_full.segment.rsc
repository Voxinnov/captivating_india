13:["$","p","Day 4 – Mysore – train – Chennai: Mornin",{"children":"Day 4 – Mysore – train – Chennai: Morning at a local farmers’ market before boarding the Shatabdi Express to Chennai. Overnight at a centrally located first-class hotel."}]
14:["$","p","Day 5 – Chennai: Visit Kalakshetra and i",{"children":"Day 5 – Chennai: Visit Kalakshetra and its textile unit, then DakshinChitra, a living heritage centre showcasing the lifestyle, architecture and crafts of South India."}]
15:["$","p","Day 6 – Chennai – Mahabalipuram – Pondic",{"children":"Day 6 – Chennai – Mahabalipuram – Pondicherry: Drive to Pondicherry via the Pallava temples at Mahabalipuram, among the earliest granite temples in India."}]
16:["$","p","Day 7 – Pondicherry: A guided “Day in Au",{"children":"Day 7 – Pondicherry: A guided “Day in Auroville” to understand the community’s eco‑friendly practices, green industries and alternate living philosophy."}]
17:["$","p","Day 8 – Pondicherry: Walking tour of the",{"children":"Day 8 – Pondicherry: Walking tour of the French and Tamil quarters with visits to an embroidery centre and weaving initiatives that support local women."}]
18:["$","p","Day 9 – Pondicherry – Kumbakonam: Drive ",{"children":"Day 9 – Pondicherry – Kumbakonam: Drive to Kumbakonam via Gangaikondacholapuram temple. Stay in a rural property ideal for exploring village life."}]
19:["$","p","Day 10 – Kumbakonam: Explore weaving vil",{"children":"Day 10 – Kumbakonam: Explore weaving villages where communities continue age‑old silk weaving methods, along with bronze casting units and Tanjore painting workshops."}]
1a:["$","p","Day 11 – Kumbakonam – Chettinad – Madura",{"children":"Day 11 – Kumbakonam – Chettinad – Madurai: Drive to Madurai via Tanjore temple and the heritage mansions of Chettinad."}]
1b:["$","p","Day 12 – Madurai: Discover lesser‑known ",{"children":"Day 12 – Madurai: Discover lesser‑known sights, a clay idol‑making village, Vedic school, flower market and heritage walk including the Meenakshi Temple complex."}]
1c:["$","p","Day 13 – Madurai – Munnar: Drive to Munn",{"children":"Day 13 – Madurai – Munnar: Drive to Munnar, followed by a plantation tour and walk in the estate."}]
1d:["$","p","Day 14 – Munnar: Visit Srishti, a charit",{"children":"Day 14 – Munnar: Visit Srishti, a charitable textile and paper unit using organic dyes and recycled materials, and a tea estate to see tea production."}]
1e:["$","p","Day 15 – Munnar – Alleppey: Drive to All",{"children":"Day 15 – Munnar – Alleppey: Drive to Alleppey and board a private riceboat for an overnight backwater cruise."}]
1f:["$","p","Day 16 – Alleppey – Cochin: Disembark an",{"children":"Day 16 – Alleppey – Cochin: Disembark and continue to Cochin. Afternoon tuk‑tuk tour of Fort Cochin and Mattancherry, including Dutch Palace and synagogue."}]
20:["$","p","Day 17 – Cochin: Excursion to Chendamang",{"children":"Day 17 – Cochin: Excursion to Chendamangalam and Cherai to visit weaving villages and enjoy time by the seaside."}]
21:["$","p","Day 18 – Departure: Transfer to the airp",{"children":"Day 18 – Departure: Transfer to the airport for your onward flight."}]
22:["$","$L12",null,{"value":"highlights","className":"leading-relaxed","children":["$","div",null,{"className":"bg-card rounded-2xl shadow-sm border border-border/60 p-6 md:p-8 space-y-4","children":[["$","h2",null,{"className":"text-base md:text-lg font-semibold text-foreground mb-3","children":"Highlights"}],["$","ul",null,{"className":"list-disc pl-5 space-y-1","children":[["$","li","Interact with master weavers in family‑r",{"children":"Interact with master weavers in family‑run looms."}],["$","li","Visit temples whose architecture inspire",{"children":"Visit temples whose architecture inspires saree patterns."}],["$","li","Visit artisan villages, handloom units a",{"children":"Visit artisan villages, handloom units and tile‑making workshops."}],["$","li","Tour Chettinad mansions showcasing Art D",{"children":"Tour Chettinad mansions showcasing Art Deco and colonial fusion design."}],["$","li","Explore the Brihadeeswarar Temple (UNESC",{"children":"Explore the Brihadeeswarar Temple (UNESCO World Heritage Site) and other Chola temples."}],["$","li","Discover Tanjore painting workshops and ",{"children":"Discover Tanjore painting workshops and traditional bronze casting."}],["$","li","Learn about indigo dyeing, block printin",{"children":"Learn about indigo dyeing, block printing and the use of natural fabrics."}],["$","li","Experience a blend of French colonial cu",{"children":"Experience a blend of French colonial culture and Tamil craft traditions in Pondicherry."}],["$","li","Participate in cooking classes featuring",{"children":"Participate in cooking classes featuring regional cuisine such as Chettinad or Tamil Brahmin dishes."}],["$","li","Visit heritage towns, bustling local mar",{"children":"Visit heritage towns, bustling local markets and grand mansions."}],["$","li","Follow the production of silk from cocoo",{"children":"Follow the production of silk from cocoon to yarn and see how Mysore silk is made."}]]}]]}]}]
