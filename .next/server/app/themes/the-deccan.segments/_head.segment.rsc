6:[["$","title","0",{"children":"The Deccan - Captivating India"}],["$","meta","1",{"name":"description","content":"Stretching across the heart of southern India, the Deccan is a land of ancient kingdoms, dramatic landscapes and extraordinary cultural diversity. From the grand palaces of Hyderabad and the evocative ruins of Hampi to the sculpted temples of Badami and Pattadakal, its history reveals the legacy of Hindu, Muslim and European influences. Beyond its monuments lie vast plateaux, coffee and spice country, traditional villages and a slower rhythm of life."}],["$","meta","2",{"name":"generator","content":"v0.app"}]]
